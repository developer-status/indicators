//@version=5
indicator("3-Step SMC Confirmation", overlay=true,
     max_boxes_count=200, max_lines_count=20, max_labels_count=10)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
// ① Anchor
i_anc     = input.bool(true,  "Show 15min Anchor H/L",     group="① Anchor")
i_anc_col = input.color(color.new(color.orange,0), "Color", group="① Anchor")

// ② Strength / Weakness
i_sw      = input.bool(false, "Show Strength/Weakness bg",  group="② Strength vs Weakness")
i_str_col = input.color(color.new(color.teal,82), "Bull",   group="② Strength vs Weakness")
i_wk_col  = input.color(color.new(color.red, 82), "Bear",   group="② Strength vs Weakness")
i_body_th = input.float(0.65, "Min Body Ratio",             group="② Strength vs Weakness", minval=0.1, maxval=1.0, step=0.05)

// ③ FVG
i_f15     = input.bool(true,  "15min FVGs",                 group="③ Fair Value Gaps")
i_f5      = input.bool(true,  "5min FVGs",                  group="③ Fair Value Gaps")
i_f1      = input.bool(true,  "1min FVGs",                  group="③ Fair Value Gaps")
i_bull    = input.color(color.new(#00bcd4,82), "Bullish",   group="③ Fair Value Gaps")
i_bear    = input.color(color.new(#f44336,82), "Bearish",   group="③ Fair Value Gaps")
i_used    = input.color(color.new(color.gray,92), "Filled", group="③ Fair Value Gaps")
i_nfvg    = input.int(5,   "Max FVGs per TF",               group="③ Fair Value Gaps", minval=1, maxval=20)
i_ext     = input.int(100, "Box width (bars)",               group="③ Fair Value Gaps", minval=10, maxval=500)

// ─── TYPE ─────────────────────────────────────────────────────────────────────
type FVG
    box   bx
    float top
    float bot
    bool  is_used

// ─── STATE ────────────────────────────────────────────────────────────────────
var FVG[] a15 = array.new<FVG>()
var FVG[] a5  = array.new<FVG>()
var FVG[] a1  = array.new<FVG>()
var line  lh  = na
var line  ll  = na
var label lbl = na

// ─── SECURITY CALLS ───────────────────────────────────────────────────────────
anc_h  = request.security(syminfo.tickerid, "15", high[1], lookahead=barmerge.lookahead_on)
anc_l  = request.security(syminfo.tickerid, "15", low[1],  lookahead=barmerge.lookahead_on)
anc_m  = math.avg(anc_h, anc_l)

o5 = request.security(syminfo.tickerid, "5", open,  lookahead=barmerge.lookahead_on)
h5 = request.security(syminfo.tickerid, "5", high,  lookahead=barmerge.lookahead_on)
l5 = request.security(syminfo.tickerid, "5", low,   lookahead=barmerge.lookahead_on)
c5 = request.security(syminfo.tickerid, "5", close, lookahead=barmerge.lookahead_on)

h15c1 = request.security(syminfo.tickerid, "15", high[1], lookahead=barmerge.lookahead_on)
l15c1 = request.security(syminfo.tickerid, "15", low[1],  lookahead=barmerge.lookahead_on)
h15c3 = request.security(syminfo.tickerid, "15", high[3], lookahead=barmerge.lookahead_on)
l15c3 = request.security(syminfo.tickerid, "15", low[3],  lookahead=barmerge.lookahead_on)

h5c1 = request.security(syminfo.tickerid, "5", high[1], lookahead=barmerge.lookahead_on)
l5c1 = request.security(syminfo.tickerid, "5", low[1],  lookahead=barmerge.lookahead_on)
h5c3 = request.security(syminfo.tickerid, "5", high[3], lookahead=barmerge.lookahead_on)
l5c3 = request.security(syminfo.tickerid, "5", low[3],  lookahead=barmerge.lookahead_on)

// ─── HELPERS ──────────────────────────────────────────────────────────────────
f_add(arr, is_bull, top, bot, bw) =>
    if array.size(arr) >= i_nfvg
        old = array.shift(arr)
        box.delete(old.bx)
    col = is_bull ? i_bull : i_bear
    bx  = box.new(bar_index - 2, top, bar_index + i_ext, bot, bgcolor=col, border_color=col, border_width=bw)
    array.push(arr, FVG.new(bx, top, bot, false))

f_fill(arr) =>
    n = array.size(arr)
    if n > 0
        for i = 0 to n - 1
            f = array.get(arr, i)
            if not f.is_used and high >= f.bot and low <= f.top
                f.is_used := true
                box.set_bgcolor(f.bx, i_used)
                box.set_border_color(f.bx, i_used)

// ─── ① ANCHOR ─────────────────────────────────────────────────────────────────
if i_anc and (timeframe.change("15") or barstate.isfirst)
    line.delete(lh)
    line.delete(ll)
    label.delete(lbl)
    lh  := line.new(bar_index, anc_h, bar_index + 1, anc_h, extend=extend.right, color=i_anc_col, style=line.style_dashed, width=1)
    ll  := line.new(bar_index, anc_l, bar_index + 1, anc_l, extend=extend.right, color=i_anc_col, style=line.style_dashed, width=1)
    bias_str = close >= anc_m ? "▲ Bull" : "▼ Bear"
    lbl := label.new(bar_index, anc_m, bias_str, style=label.style_label_right, color=color.new(i_anc_col,75), textcolor=color.white, size=size.small)

// ─── ② STRENGTH VS WEAKNESS ───────────────────────────────────────────────────
rng5   = h5 - l5
body5  = math.abs(c5 - o5)
ratio5 = rng5 > 0 ? body5 / rng5 : 0.0
is_str = c5 > o5 and ratio5 >= i_body_th and (h5 - c5) <= body5 * 0.3
is_wk  = c5 < o5 and ratio5 >= i_body_th and (c5 - l5) <= body5 * 0.3
sw_on  = i_sw and timeframe.in_seconds() <= 300
bgcolor(sw_on ? (is_str ? i_str_col : is_wk ? i_wk_col : na) : na, title="S/W Background")

// ─── ③ FVG 15min ──────────────────────────────────────────────────────────────
if i_f15 and timeframe.change("15")
    if l15c1 > h15c3
        f_add(a15, true,  l15c1, h15c3, 2)
    if h15c1 < l15c3
        f_add(a15, false, l15c3, h15c1, 2)
f_fill(a15)

// ─── ③ FVG 5min ───────────────────────────────────────────────────────────────
if i_f5 and timeframe.in_seconds() <= 300 and timeframe.change("5")
    if l5c1 > h5c3
        f_add(a5, true,  l5c1, h5c3, 1)
    if h5c1 < l5c3
        f_add(a5, false, l5c3, h5c1, 1)
f_fill(a5)

// ─── ③ FVG 1min ───────────────────────────────────────────────────────────────
if i_f1 and timeframe.in_seconds() <= 60 and barstate.isconfirmed
    if low > high[2]
        f_add(a1, true,  low,    high[2], 1)
    if high < low[2]
        f_add(a1, false, low[2], high,    1)
f_fill(a1)
